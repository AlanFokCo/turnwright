# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# lathe build output (go build -o lathe ./cmd/lathe)
/turnwright

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Node / TUI
node_modules/
dist/
*.tsbuildinfo

# engine binary (v2)
/turnwright-engine

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Local-only design docs (brainstorming specs/plans) — keep local, not on GitHub
docs/superpowers/
docs/design/

# local agent state dirs
.remember/
.qwen/
.superpowers/

# site
site/dist/
.astro/
