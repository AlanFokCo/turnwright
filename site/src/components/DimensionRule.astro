---
/** Engineering dimension-line decoration: ◄── hairline ── LABEL ── hairline ──►
 *  Used at section boundaries only (decoration is rationed — spec §2). */
interface Props { label?: string; }
const { label = "" } = Astro.props;
---
<div class="dim-rule" aria-hidden="true">
  <svg width="10" height="8" viewBox="0 0 10 8"><path d="M10 0 L0 4 L10 8" fill="none" stroke="currentColor" stroke-width="1"/></svg>
  <div class="line"></div>
  {label && <span class="label">{label}</span>}
  <div class="line"></div>
  <svg width="10" height="8" viewBox="0 0 10 8"><path d="M0 0 L10 4 L0 8" fill="none" stroke="currentColor" stroke-width="1"/></svg>
</div>

<style>
  .dim-rule { display: flex; align-items: center; gap: 10px; color: var(--muted); width: 100%; }
  .line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--border) 20%, var(--border) 80%, transparent); }
  .label {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--muted); white-space: nowrap;
  }
</style>
