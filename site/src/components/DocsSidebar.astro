---
interface NavItem { slug: string; title: string }
interface Props { items: NavItem[]; slug: string; }
const { items, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<nav class="docs-nav" aria-label="Documentation">
  <a class="brand" href={base}><span aria-hidden="true">┌┬┐</span> turnwright</a>
  <p class="label">Documentation</p>
  <ol>
    {items.map((it, i) => (
      <li>
        <a href={`${base}docs/${it.slug}/`} aria-current={it.slug === slug ? "page" : undefined}>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <span class="t">{it.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <a class="gh" href="https://github.com/AlanFokCo/turnwright">GitHub ↗</a>
</nav>

<style>
  .docs-nav { display: flex; flex-direction: column; gap: calc(var(--space) * 2); }
  .brand {
    font-family: var(--font-mono); font-weight: 700; font-size: 15px;
    color: var(--text); text-decoration: none; letter-spacing: -0.01em;
  }
  .brand span { color: var(--accent); }
  .label { margin: calc(var(--space) * 2) 0 calc(var(--space) * 1); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  ol a {
    display: flex; gap: 8px; align-items: baseline;
    padding: 6px 10px; text-decoration: none; color: var(--muted);
    font-size: 13.5px; line-height: 1.4;
    border-left: 2px solid transparent;
    transition: color 150ms var(--ease-machine), border-color 150ms var(--ease-machine);
  }
  ol a:hover { color: var(--text); }
  ol a[aria-current="page"] {
    color: var(--text); border-left-color: var(--accent);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .num { font-family: var(--font-mono); font-size: 10px; opacity: 0.6; min-width: 1.4em; }
  .gh { font-size: 12.5px; color: var(--muted); text-decoration: none; margin-top: calc(var(--space) * 2); }
  .gh:hover { color: var(--accent); }
</style>
