---
import { DOCS_ORDER, firstH1 } from "@/lib/docsNav";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const entries = await getCollection("docs");
const links = DOCS_ORDER.map((slug) => {
  const e = entries.find((x) => x.id === slug);
  return { slug, title: e ? firstH1(e.body ?? "") : slug };
});
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <div class="col brand-col">
      <p class="brand"><span aria-hidden="true">┌┬┐</span> turnwright</p>
      <p class="tagline">shape your code at the lathe</p>
      <p class="meta">MIT License · built at the lathe · {year}</p>
    </div>
    <div class="col">
      <p class="label">Documentation</p>
      <ul>
        {links.map((l) => <li><a href={`${base}docs/${l.slug}/`}>{l.title}</a></li>)}
      </ul>
    </div>
    <div class="col">
      <p class="label">Project</p>
      <ul>
        <li><a href="https://github.com/AlanFokCo/turnwright">GitHub ↗</a></li>
        <li><a href="https://www.npmjs.com/package/@turnwright/cli">npm ↗</a></li>
        <li><a href="https://github.com/AlanFokCo/turnwright/issues">Issues ↗</a></li>
        <li><a href="https://github.com/agentscope-ai/agentscope-go">agentscope-go ↗</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--hairline); background: color-mix(in srgb, var(--surface) 35%, var(--bg)); }
  .inner {
    max-width: 1200px; margin-inline: auto; padding: calc(var(--space) * 8) var(--gutter);
    display: grid; grid-template-columns: 2fr 1.2fr 1fr; gap: calc(var(--space) * 8);
  }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; gap: calc(var(--space) * 5); } }
  .brand { font-family: var(--font-mono); font-weight: 700; font-size: 15px; color: var(--text); margin: 0 0 6px; }
  .brand span { color: var(--accent); }
  .tagline { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted-text); margin: 0 0 16px; }
  .meta { font-size: 11.5px; color: var(--muted-text); margin: 0; }
  .col .label { margin: 0 0 10px; }
  .col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .col a { font-size: 13px; color: var(--muted-text); text-decoration: none; transition: color 150ms var(--ease-machine); }
  .col a:hover { color: var(--accent); }
</style>
