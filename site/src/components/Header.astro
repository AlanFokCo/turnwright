---
import InstallChip from "./InstallChip.astro";
import ScrollProgress from "./ScrollProgress.astro";

const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={base} aria-label="turnwright home">
      <span class="mark" aria-hidden="true">┌┬┐</span>
      <span class="wordmark">turnwright</span>
    </a>
    <nav aria-label="Primary">
      <a href={`${base}docs/`}>Docs</a>
      <a href="https://github.com/AlanFokCo/turnwright">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="cta"><InstallChip compact /></div>
  </div>
  <ScrollProgress />
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--hairline);
  }
  .inner {
    max-width: 1200px; margin-inline: auto;
    display: flex; align-items: center; gap: calc(var(--space) * 4);
    height: 56px; padding-inline: var(--gutter);
  }
  @media (max-width: 640px) { .inner { height: 48px; gap: calc(var(--space) * 2); } }
  .brand { display: inline-flex; align-items: baseline; gap: 8px; text-decoration: none; }
  .mark { font-family: var(--font-mono); color: var(--accent); font-size: 14px; font-weight: 700; }
  .wordmark {
    font-family: var(--font-mono); font-weight: 700; font-size: 15px;
    letter-spacing: -0.01em; color: var(--text);
  }
  nav { display: flex; gap: calc(var(--space) * 3); margin-left: auto; }
  nav a {
    font-size: 13px; color: var(--muted-text); text-decoration: none;
    padding: 6px 2px; position: relative;
    transition: color 150ms var(--ease-machine);
  }
  nav a::after {
    content: ""; position: absolute; left: 0; right: 100%; bottom: 2px; height: 1px;
    background: var(--accent); transition: right 200ms var(--ease-machine);
  }
  nav a:hover { color: var(--text); }
  nav a:hover::after { right: 0; }
  @media (max-width: 480px) { .cta { display: none; } }
</style>
