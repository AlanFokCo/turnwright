---
/** Interactive playground stage. The SSR'd terminal frame is the JS-off
 *  visual; a <noscript> chip explains the missing interactivity. */
import Playground from "@/islands/Playground.tsx";
---
<div class="player-wrap" data-player-wrap>
  <Playground client:visible />
  <noscript>
    <p class="js-note">JS required to play — the interactive terminal needs scripting</p>
  </noscript>
</div>

<style>
  .player-wrap :global(.term), .player-wrap :global(astro-island) { width: 100%; }
</style>
