{
  "name": "@turnwright/cli",
  "version": "2.0.0-alpha.2",
  "description": "turnwright — a common coding agent (agentscope-go engine + OpenTUI client)",
  "type": "module",
  "bin": { "turnwright": "./bin/turnwright.js" },
  "files": ["bin", "dist"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --passWithNoTests" },
  "dependencies": {
    "@opentui/core": "^0.6.1",
    "@opentui/react": "^0.6.1",
    "react": "^19.0.0"
  },
  "optionalDependencies": {
    "@turnwright/engine-darwin-x64": "2.0.0-alpha.2",
    "@turnwright/engine-darwin-arm64": "2.0.0-alpha.2",
    "@turnwright/engine-linux-x64": "2.0.0-alpha.2",
    "@turnwright/engine-linux-arm64": "2.0.0-alpha.2"
  },
  "devDependencies": { "typescript": "^5.9.0", "@types/node": "^22.0.0", "vitest": "^3.0.0" },
  "engines": { "bun": ">=1.4" }
}
